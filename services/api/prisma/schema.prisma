generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  WORKER
  ADMIN
}

model User {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  role      UserRole  @default(USER)

  /// WeChat openid / unionid placeholders (to be implemented)
  wechatOpenId  String? @unique
  wechatUnionId String? @unique

  nickname  String?
  avatarUrl String? @db.Text
  /// 小程序钱包可用余额（业务演示字段）
  walletBalance Decimal @default(0) @db.Decimal(12, 2)
  /// 微信 phonenumber.getPhoneNumber 换取的手机号（含区号等，与微信返回一致）
  phone     String? @unique

  workerProfile WorkerProfile?
  refreshTokens  RefreshToken[]
  orders         BizOrder[]
}

model WorkerProfile {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  primaryGame String
  rankText    String
  specialties Json     @default("[]")
}

/// 刷新令牌持久化（仅存哈希，不落明文），用于轮换与吊销
model RefreshToken {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

// ----- 业务落库（商品 / 订单 / 客服 / 打手入驻） -----

enum CatalogProductStatus {
  enabled
  disabled
}

enum BizOrderStatus {
  pendingPay
  pendingTake
  serving
  pendingDone
  done
  cancelled
}

enum BizRefundStatus {
  none
  pending
  approved
  rejected
}

enum WorkerJoinApplicationStatus {
  submitted
  reviewing
  approved
  rejected
}

enum WorkerAccountOperationalStatus {
  active
  disabled
}

/// Prisma 枚举不可含连字符；API 仍为 "all-around"，读写时做映射
enum WorkerAssessmentKind {
  moba
  fps
  strategy
  all_around
}

model ProductCategory {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name      String
  disabled  Boolean  @default(false)
  createdBy String

  products Product[]
}

model Product {
  id        String               @id
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  name          String
  imageUrl      String             @db.Text
  heroImages    Json               @default("[]")
  titleAccent   String             @default("")
  categoryId    String
  category      ProductCategory    @relation(fields: [categoryId], references: [id], onUpdate: Cascade)
  categoryName  String

  price         Decimal            @db.Decimal(12, 2)
  originPrice   Decimal?           @db.Decimal(12, 2)
  stockText     String             @default("")
  badges        Json               @default("[]")
  descriptionLines Json            @default("[]")
  notices       Json               @default("[]")

  status        CatalogProductStatus @default(enabled)
  createdBy     String

  orders BizOrder[]

  @@index([categoryId])
  @@index([status])
}

model CustomerServiceAgent {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nickname    String
  wechatId    String
  disabled    Boolean @default(false)
  avatarUrl   String  @db.Text
  wechatQrUrl String  @db.Text

  @@index([disabled])
}

/// 入驻申请（userId 不强制 FK User，兼容演示数据与离线审核）
model WorkerJoinApplication {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refNo    String @unique
  userId   String

  realName String
  age      Int
  phone    String
  idNo     String

  assessmentType WorkerAssessmentKind
  status         WorkerJoinApplicationStatus
  rejectReason   String?

  @@index([userId])
  @@index([status])
}

/// 已通过审核的打手账号（工作台接单用 JWT sub = userId；与 WorkerProfile 不同）
model WorkerAccount {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId   String @unique

  realName String
  phone    String

  assessmentType WorkerAssessmentKind
  joinStatus     WorkerJoinApplicationStatus @default(approved)
  status         WorkerAccountOperationalStatus @default(active)

  @@index([joinStatus])
  @@index([status])
}

enum AdminManagerRole {
  admin
  customer_service
}

enum AdminAccountStatus {
  active
  disabled
}

/// 老板在后台创建的管理员账号（owner 账号硬编码在服务里，不入库）
model AdminAccount {
  id           String             @id @default(cuid())
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  username     String             @unique
  displayName  String
  passwordHash String
  role         AdminManagerRole   @default(admin)
  status       AdminAccountStatus @default(active)

  @@index([status])
}

model BizOrder {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderNo     String           @unique
  status      BizOrderStatus
  packageTag  String
  serviceTitle String
  amount      Decimal          @db.Decimal(12, 2)
  quantityText String
  coverImage  String           @db.Text

  payMethod   String
  paidAmount  Decimal          @db.Decimal(12, 2)
  deliveries  Json             @default("[]")

  createdBy String
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  productId String?
  product   Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  refundStatus     BizRefundStatus @default(none)
  assignedWorkerId String?
  assignedAt       String          @default("")
  completedAt      String          @default("")
  wxTransactionId  String?

  @@index([userId, status])
  @@index([status])
  @@index([assignedWorkerId])
  @@index([createdAt])
  @@map("biz_orders")
}

/// 首页轮播图
model HomeBanner {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title      String
  subtitle   String
  imageUrl   String   @db.Text
  linkUrl    String?  @db.Text
  sortOrder  Int      @default(0)
  enabled    Boolean  @default(true)
  createdBy  String

  @@index([enabled, sortOrder])
}

/// 首页滚动通知
model HomeNotice {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  content    String
  sortOrder  Int      @default(0)
  enabled    Boolean  @default(true)
  createdBy  String

  @@index([enabled, sortOrder])
}
